{
  "name": "sms-loc",
  "description": "SMSLocFD",
  "private": true,
  "version": "0.0.18",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint ./src",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --skipLibCheck true",
    "fmt": "prettier --write ./src",
    "fmt.check": "prettier --check ./src",
    "ionic-serve": "yarn configure:dev -y && ionic serve",
    "ionic-build": "yarn configure:prod -y && ionic build ionic cap copy",
    "ionic-sync": "ionic cap sync",
    "ionic-capacitor-open-android": "ionic cap open android",
    "ionic-capacitor-run-android": "ionic capacitor run android",
    "ionic-live-reload": "ionic cap run android --livereload-url=http://localhost:8100",
    "ionic-capacitor-add-android": "ionic capacitor add android",
    "ionic-capacitor-add-ios": "ionic capacitor add ios",
    "ionic-capacitor-copy-android": "ionic capacitor copy android",
    "cordova-res-android": "cordova-res android --skip-config --copy",
    "cap": "cap",
    "docker:build": "./deploy/docker/docker-build.sh",
    "docker:compile": "./deploy/docker/docker-compile.sh",
    "docker:generate:keystore": "./deploy/docker/docker-generate-keystore.sh",
    "docker:interactive": "./deploy/docker/docker-interactive.sh",
    "docker:swift-android-sdk": "docker build -f deploy/docker/swift-android-sdk/Dockerfile -t ghcr.io/primozs/sms-loc-fdroid/swift-android-sdk:6.3.3-aarch64-api24 .",
    "configure:dev": "./config/configure.dev.sh",
    "configure:prod": "./config/configure.prod.sh",
    "fdroid-build": "./scripts/fdroid-build.sh",
    "trapeze": "trapeze"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capawesome/capacitor-navigation-bar": "^8.0.1",
    "@ionic/vue": "^8.8.17",
    "@ionic/vue-router": "^8.8.17",
    "@tanstack/vue-query": "^5.85.5",
    "@vue/devtools-api": "^8",
    "@vueuse/core": "^14",
    "colormap": "^2.3.2",
    "dayjs": "^1.11.15",
    "ionicons": "^8.0.13",
    "maplibre-gl": "^6.2.0",
    "marked": "^18",
    "pinia": "^4",
    "swiper": "^14",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10",
    "@ionic/cli": "^7.2.1",
    "@trapezedev/configure": "^7.1.3",
    "@types/colormap": "^2.3.4",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.20",
    "eslint": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^17",
    "jsdom": "^29",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "terser": "^5.49.2",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10",
    "vue-tsc": "^3.3.9"
  }
}
